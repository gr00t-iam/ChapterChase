DATABASE_URL="file:../data/chapterchase.db"
CHAPTERCHASE_DATA_DIR="./data"
CHAPTERCHASE_LIBRARY_DIR="/library"
# Optional: starting points shown by Browse for Media Folders.
# Leave broad for local testing, or set to mounted NAS paths in production.
CHAPTERCHASE_MEDIA_ROOTS="/library"
# Set true if you want admins limited to CHAPTERCHASE_MEDIA_ROOTS.
CHAPTERCHASE_RESTRICT_MEDIA_ROOTS="false"
# Optional local sherpa-onnx Kokoro TTS model directory.
# Defaults to "$CHAPTERCHASE_DATA_DIR/tts/kokoro-en-v0_19".
CHAPTERCHASE_TTS_MODEL_DIR=""
CHAPTERCHASE_TTS_THREADS="2"
CHAPTERCHASE_TTS_SPEED="1"
NODE_ENV="production"
CHAPTERCHASE_APP_URL="http://localhost:3000"
# Use false for plain HTTP LAN/NAS testing. Set true only behind HTTPS.
CHAPTERCHASE_SECURE_COOKIES="false"
# Optional SMTP settings for account verification and password recovery.
# If omitted, ChapterChase logs email links to the server console for local testing.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="ChapterChase <no-reply@example.com>"
# Optional Hardcover GraphQL API token for metadata and cover enrichment.
# Keep this server-side only; never expose it to browser code.
HARDCOVER_API_KEY="eyJhbGciOiJIUzI1NiJ9..mH_gB6v0rk35R44FLWJ_smtGnRQ6FYgf7Ts7s-M6DxE"
